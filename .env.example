# ElevenLabs narrator. Salin ke .env lalu isi. Jangan pernah commit .env.

# 1. API key: elevenlabs.io > Settings/Developers > API Keys
ELEVENLABS_API_KEY=

# 2. Voice ID (jalankan: .venv/Scripts/python.exe tools/voices_list.py)
ELEVENLABS_VOICE_ID=

# Opsional (default sudah cukup)
ELEVENLABS_MODEL_ID=
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
